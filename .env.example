# Copy this file to .env.local and fill in real values before running the site.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# TODO: INSERT YOUR GOOGLE OAUTH CLIENT ID HERE
GOOGLE_CLIENT_ID=
# TODO: INSERT YOUR GOOGLE OAUTH CLIENT SECRET HERE
GOOGLE_CLIENT_SECRET=

# Only used by the demo in-memory OTP store to log codes to the server console
# instead of actually sending email/SMS. Replace with a real provider before production
# (see lib/otpStore.ts for exactly what to swap out).
OTP_DEBUG_LOG=true
